# MatchHai load-test environment template.
# Copy to a local file (e.g. .env.load) and fill in STAGING values only.
# DO NOT commit real tokens. DO NOT put production URLs here.
#
# k6 reads these via -e KEY=VALUE or via a dotenv loader you control.
# Example (PowerShell), passing one at a time:
#   k6 run -e CONVEX_TEST_TOKEN=xxx -e PROFILE=load100 load-tests/scenarios/stress.js

# Convex STAGING .site origin (custom httpAction routes: auth, easypaisa, etc.)
# Default if unset: https://quick-panda-920.convex.site
CONVEX_SITE_URL=https://quick-panda-920.convex.site

# Convex STAGING .cloud origin (generic function API: /api/query, /api/mutation).
# Default if unset: https://quick-panda-920.convex.cloud
CONVEX_URL=https://quick-panda-920.convex.cloud

# Bearer token for authenticated flows. STAGING test user only.
# Leave blank to run unauthenticated reachability/no-5xx checks only.
# See README.md "Authentication" for how to mint a staging test token.
CONVEX_TEST_TOKEN=

# Optional: a disposable STAGING zone id for parameterised reads/writes.
TARGET_ZONE_ID=

# Optional: a disposable STAGING matchroom id for parameterised reads and the
# race scenario (the contended slot).
TARGET_MATCHROOM_ID=

# Which ramp profile stress.js should use: load100 | load500 | load1000.
# smoke.js ignores this (it always uses the smoke profile).
PROFILE=smoke
