# =============================================================================
# .env.test.example — MatchHai test/QA configuration template
# =============================================================================
#
# **STAGING / DEV ONLY. NEVER POINT THIS AT PRODUCTION.**
# **NEVER COMMIT REAL VALUES OR SECRETS.** Copy this file to `.env.test`
# (git-ignored) and fill values from the shared secrets vault.
#
# This file documents the configuration needed to seed a controlled test
# dataset and run unit / E2E / load tests against the MatchHai Convex staging
# deployment. See docs/TEST_DATA.md for the full guide.
#
# SAFETY: The seed/cleanup .mjs scripts and convex/devCleanup hard-refuse to
# run unless CONVEX_DEPLOYMENT begins with "dev:" (and refuse "prod:"). Confirm
# CONVEX_DEPLOYMENT below points to the staging/dev deployment BEFORE seeding.
# =============================================================================

# --- Convex deployment (STAGING ONLY) ----------------------------------------
# Staging deployment URL. Must NOT be a production deployment.
EXPO_PUBLIC_CONVEX_URL=https://quick-panda-920.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://quick-panda-920.convex.site
# Seed/cleanup scripts require this to start with "dev:" — paste the staging
# deployment identifier here (e.g. dev:quick-panda-920). Never "prod:".
CONVEX_DEPLOYMENT=dev:quick-panda-920

# --- Seed authorization -------------------------------------------------------
# Set in the Convex dashboard env for the STAGING deployment (server-side):
#   DEMO_SEED_ENABLED=true
#   DEMO_SEED_KEY=<the secret seed key>
# The value below is the same key passed as argv to the seed scripts and as
# `seedKey` in seed_args.json. Keep it secret; placeholder only here.
DEMO_SEED_KEY=replace-with-staging-seed-key

# --- Controlled test cast (emails) -------------------------------------------
# These are the canonical roles used by unit fixtures (__tests__/fixtures/index.ts)
# and should map to seeded staging accounts. Use the staging demo domain so the
# cleanup scripts can find and remove them. (.demo domain == removable demo data.)
TEST_PLAYER_A_EMAIL=test.player.a@matchhai.demo
TEST_PLAYER_B_EMAIL=test.player.b@matchhai.demo
TEST_CAPTAIN_A_EMAIL=test.captain.a@matchhai.demo
TEST_CAPTAIN_B_EMAIL=test.captain.b@matchhai.demo
TEST_ZONE_ADMIN_EMAIL=test.zone.admin@matchhai.demo
TEST_OTHER_ZONE_ADMIN_EMAIL=test.other.zone.admin@matchhai.demo
TEST_SUPER_ADMIN_EMAIL=test.superadmin@matchhai.demo
TEST_DELETED_USER_EMAIL=test.deleted@matchhai.demo

# --- Shared test password -----------------------------------------------------
# The seed actions hash a shared demo password for all .demo credential accounts.
# Karachi-realistic seed uses "Demo@123456"; legacy demoSeed uses "MatchHaiDemo123!".
# Keep the real value out of git; this is a placeholder.
TEST_USER_PASSWORD=replace-with-shared-demo-password

# --- Optional load-test knobs -------------------------------------------------
# Used only if your load harness reads them. Tune to staging capacity.
TEST_LOAD_VUS=50
TEST_LOAD_DURATION=2m
