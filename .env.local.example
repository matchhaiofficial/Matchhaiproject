# Copy this file to .env.local and fill values from the shared secrets vault.
# Do not commit real values.

CONVEX_DEPLOYMENT=dev:your-convex-deployment
EXPO_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site
EXPO_PUBLIC_SUPER_ADMIN_EMAIL=superadmin@example.com
EXPO_PUBLIC_APP_SCHEME=matchhai
EXPO_PUBLIC_SUPPORT_AI_ENDPOINT=https://your-worker-url.workers.dev
EXPO_PUBLIC_SUPPORT_EMAIL=admin@matchhai.com
EXPO_PUBLIC_SUPPORT_DEBUG=0

# Dev-only: bypass phone OTP verification in the signup UI.
# Keep this OFF for production builds/APKs.
EXPO_PUBLIC_SKIP_PHONE_OTP=0

# Dev-only: bypass CNIC & face verification gates in the app UI.
# EXPO_PUBLIC_SKIP_PHONE_OTP=1 also enables this bypass for local testing.
# Keep this OFF for production builds/APKs.
EXPO_PUBLIC_SKIP_KYC_VERIFICATION=0

# External APIs are set in the Convex dashboard environment for the target deployment.
STEAM_API_KEY=your-steam-api-key
FACEIT_API_KEY=your-faceit-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="MatchHai <no-reply@example.com>"
DIDIT_API_KEY=your-didit-api-key
DIDIT_KYC_WORKFLOW_ID=acbc8323-bcdc-4ea5-aaf8-8eacf978cb83
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_URL=https://your-convex-site.convex.site/kyc/didit/webhook
DIDIT_CALLBACK_URL=matchhai://

# Dev-only: bypass phone OTP requirement in Convex registration identity validation.
# Set this in your Convex dashboard env for the dev deployment only.
SKIP_PHONE_OTP=0

# Dev-only: bypass CNIC & face verification checks in Convex mutations.
# SKIP_PHONE_OTP=1 also enables this bypass for dev testing.
# Set this in your Convex dashboard env for the dev deployment only.
SKIP_KYC_VERIFICATION=0

# Optional client-side routing hints for Super Admin emails.
# Server-side access is enforced by Convex env vars in env/convex.env.example.
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_JUNAID=
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_EHTESHAN=
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_ZEERAK=
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_MUBEEN=
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_SAAD=
EXPO_PUBLIC_SUPER_ADMIN_EMAIL_OVAIS=
ANTIDEO_API_KEY=your-antideo-api-key
EASYPAISA_ENV=staging
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_HASH_KEY=your-easypaisa-hash-key
EASYPAISA_API_USERNAME=your-easypaisa-rest-username
EASYPAISA_API_PASSWORD=your-easypaisa-rest-password
EASYPAISA_ACCOUNT_NUM=your-easypaisa-account-number
EASYPAISA_DEFAULT_FLOW=rest
EASYPAISA_HOSTED_FALLBACK_ENABLED=1
# EASYPAISA_REST_BASE_URL=https://easypaystg.easypaisa.com.pk/easypay-service/rest/v4
# EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD
# EASYPAISA_IPN_ALLOWED_HOSTS=easypay.easypaisa.com.pk,easypaystg.easypaisa.com.pk
# PSN_NPSSO=your-psn-npsso-token
