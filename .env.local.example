# Copy this file to .env.local and fill values from the shared secrets vault.
# Do not commit real values.

CONVEX_DEPLOYMENT=dev:your-convex-deployment
EXPO_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site
EXPO_PUBLIC_SUPER_ADMIN_EMAIL=superadmin@example.com
EXPO_PUBLIC_APP_SCHEME=matchhai
EXPO_PUBLIC_SUPPORT_AI_ENDPOINT=https://your-worker-url.workers.dev
EXPO_PUBLIC_SUPPORT_EMAIL=admin@matchhai.com

# External APIs are set in the Convex dashboard environment for the target deployment.
STEAM_API_KEY=your-steam-api-key
FACEIT_API_KEY=your-faceit-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="MatchHai <no-reply@example.com>"
ANTIDEO_API_KEY=your-antideo-api-key
EASYPAISA_ENV=staging
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_HASH_KEY=your-easypaisa-hash-key
EASYPAISA_API_USERNAME=your-easypaisa-rest-username
EASYPAISA_API_PASSWORD=your-easypaisa-rest-password
EASYPAISA_ACCOUNT_NUM=your-easypaisa-account-number
EASYPAISA_DEFAULT_FLOW=rest
EASYPAISA_HOSTED_FALLBACK_ENABLED=1
# EASYPAISA_REST_BASE_URL=https://easypaystg.easypaisa.com.pk/easypay-service/rest/v4
# EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD
# EASYPAISA_IPN_ALLOWED_HOSTS=easypay.easypaisa.com.pk,easypaystg.easypaisa.com.pk
# PSN_NPSSO=your-psn-npsso-token
