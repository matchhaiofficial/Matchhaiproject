rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if user has super-admin role (multi-layered fallback)
    function isSuperAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super-admin") ||
        request.auth.token.email == "admin@matchhai.com" ||
        request.auth.uid == "jM2JZrPNNNahPb844rHmr0MQKYo1"
      );
    }

    // Helper to check if user is in chatroom participant list
    function isChatroomParticipant(chatId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/chatrooms/$(chatId)) &&
        get(/databases/$(database)/documents/chatrooms/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
    }

    // Frontend-only mode: derive chat access from matchroom (simple fields only)
    function isMatchroomUser(matchId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/matchrooms/$(matchId)) && (
        get(/databases/$(database)/documents/matchrooms/$(matchId)).data.hostUid == request.auth.uid ||
        get(/databases/$(database)/documents/matchrooms/$(matchId)).data.zoneOwnerUid == request.auth.uid ||
        get(/databases/$(database)/documents/matchrooms/$(matchId)).data.playerUids.hasAny([request.auth.uid])
      );
    }

    function isSelfReadReceiptUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadBy', 'updatedAt']) &&
        request.resource.data.lastReadBy[request.auth.uid] != null;
    }

    function isDeleteForMeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor', 'updatedAt']) &&
        request.resource.data.get('deletedFor', []).hasAny([request.auth.uid]);
    }

    // Users collection:
    // - Authenticated users can read any profile (for matchmaking/social)
    // - Users can only write/update their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Wallet transactions for each user
    match /users/{userId}/wallet_transactions/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(userId);
    }

    // Friends Subcollection
    match /users/{userId}/friends/{friendId} {
      allow read: if isOwner(userId);
      // Allow write if you're the owner OR if you're the friend being added (reciprocal write)
      allow write: if isOwner(userId) || request.auth.uid == friendId;
    }

    // Blocks Subcollection
    match /users/{userId}/blocks/{blockId} {
      allow read, write: if isOwner(userId);
    }

    // Notifications (Inbox)
    match /notifications/{notificationId} {
      // READ Rules:
      allow read, list: if isAuthenticated() && (
        isSuperAdmin() ||
        // 1. Existing Doc: I am the recipient
        (resource != null && resource.data.toUid == request.auth.uid) || 
        // 2. Existing Doc: I am the sender
        (resource != null && resource.data.fromUid == request.auth.uid) ||
        // 3. Existing Doc: I am the current captain of the team (handles captain transfers)
        // SAFELY access meta.teamId
        (
          resource != null && 
          resource.data.type == 'team_invite' && 
          resource.data.get('meta', {}).get('teamId', null) != null &&
          get(/databases/$(database)/documents/teams/$(resource.data.meta.teamId)).data.captainUid == request.auth.uid
        ) ||
        // 4. ID-based Fallback for Recipient (Optimization)
        notificationId.matches('.*_' + request.auth.uid + '$') ||
        // 5. Non-existant Doc: Allow reading team_invite keys to check for existence (for creation)
        (resource == null && notificationId.startsWith('team_invite__'))
      );
      
      // CREATE
      allow create: if isAuthenticated() && (request.resource.data.fromUid == request.auth.uid || isSuperAdmin());
      
      // UPDATE: 
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid ||
        // Allow captain to update (e.g. re-invite) - SAFELY access meta.teamId in EXISTING data
        (
          resource.data.type == 'team_invite' && 
          resource.data.get('meta', {}).get('teamId', null) != null &&
          get(/databases/$(database)/documents/teams/$(resource.data.meta.teamId)).data.captainUid == request.auth.uid
        ) ||
        // DEADLOCK BREAKER: Allow update if the NEW data is a valid invite from the captain of that team
        // This allows overwriting corrupt/legacy documents
        (
          request.resource.data.type == 'team_invite' &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.get('meta', {}).get('teamId', null) != null &&
          get(/databases/$(database)/documents/teams/$(request.resource.data.meta.teamId)).data.captainUid == request.auth.uid
        )
      );

      // DELETE: Allow user to delete their own notifications.
      // Also allow CAPTAIN/SENDER to delete notifications related to their team
      allow delete: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid ||
        (
          resource.data.get('meta', {}).get('teamId', null) != null && 
          get(/databases/$(database)/documents/teams/$(resource.data.meta.teamId)).data.captainUid == request.auth.uid
        )
      );
    }

    // Teams
    match /teams/{teamId} {
        allow read: if isAuthenticated();
        // Allow creating a new team
        allow create: if isAuthenticated() && request.resource.data.captainUid == request.auth.uid;
        
        // Update logic:
        // 1. Captain can update anything.
        // 2. Joining member can increment memberCount/memberUids if they have a valid invite.
        // 3. Leaving member can decrement memberCount/memberUids if they are in the array.
        allow update: if isAuthenticated() && (
            resource.data.captainUid == request.auth.uid || 
            (
                request.resource.data.memberCount == resource.data.memberCount + 1 && 
                request.resource.data.memberUids.hasAny([request.auth.uid]) &&
                exists(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + request.auth.uid )) &&
                get(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + request.auth.uid )).data.status == "pending" &&
                get(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + request.auth.uid )).data.expiresAt > request.time
            ) ||
            (
                // LEAVE LOGIC: Decrement count, remove self from array
                request.resource.data.memberCount == resource.data.memberCount - 1 &&
                resource.data.memberUids.hasAny([request.auth.uid]) &&
                !request.resource.data.memberUids.hasAny([request.auth.uid])
            )
        );

        // Allow captain to delete team
        allow delete: if isAuthenticated() && resource.data.captainUid == request.auth.uid;
    }
    
    // Team Members Subcollection
    match /teams/{teamId}/members/{memberId} {
        allow read: if isAuthenticated();
        // Allow write if:
        // 1. You are the captain (using getAfter to support batch creation).
        // 2. You are the member joining AND you have a valid invite.
        allow create: if isAuthenticated() && (
            getAfter(/databases/$(database)/documents/teams/$(teamId)).data.captainUid == request.auth.uid ||
            (
                memberId == request.auth.uid &&
                exists(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + memberId )) &&
                get(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + memberId )).data.status == "pending" &&
                get(/databases/$(database)/documents/notifications/$( "team_invite__" + teamId + "__" + memberId )).data.expiresAt > request.time
            )
        );
        allow update, delete: if isAuthenticated() && (
            get(/databases/$(database)/documents/teams/$(teamId)).data.captainUid == request.auth.uid ||
            getAfter(/databases/$(database)/documents/teams/$(teamId)).data.captainUid == request.auth.uid ||
            memberId == request.auth.uid
        );
    }

    // Matchrooms:
    // - Authenticated users can read and create matchrooms
    match /matchrooms/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Only host, captain, or a player claiming their reserved slot can update.
      // For MVP, we'll keep it relatively open but ensure only reservedForUid can claim a reserved slot
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.captainUidA == request.auth.uid ||
        resource.data.captainUidB == request.auth.uid ||
        // Slot claim logic helper
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotsA', 'slotsB', 'players', 'playerUids', 'currentPlayers', 'updatedAt']))
      ); 
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    // Chatrooms (per matchroom)
    match /chatrooms/{chatId} {
      allow read: if isMatchroomUser(chatId) || isChatroomParticipant(chatId);
      allow create: if isMatchroomUser(chatId);
      allow update: if isMatchroomUser(chatId) && (
        isSelfReadReceiptUpdate() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids', 'updatedAt'])
      );

      match /messages/{messageId} {
        allow read: if isMatchroomUser(chatId) || isChatroomParticipant(chatId);
        allow create: if isMatchroomUser(chatId) && request.resource.data.senderUid == request.auth.uid;
        allow update: if isMatchroomUser(chatId) && isDeleteForMeUpdate();
        allow delete: if false;
      }
    }

    // Booking Intents
    match /booking_intents/{intentId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        request.resource.data.createdByUid == request.auth.uid &&
        (request.resource.data.status in ["pending_approvals", "approved_pending_payment", "draft"]);

      allow update: if isAuthenticated() && (
        // Creator can update status, paymentStatus, etc. 
        // We allow creator to overwrite if status is not confirmed yet
        (resource.data.createdByUid == request.auth.uid && 
         resource.data.status != "confirmed") ||
        // Approvers can only update their specific approval status
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvals', 'status', 'updatedAt']))
      );
    }
    
    // Booking Requests (Broadcast mode)
    match /booking_requests/{requestId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Zones management
    match /zones/{zoneId} {
      // Publicly readable for finding venues (active only for players, all for admins)
      allow read: if isAuthenticated(); 
      
      // Create: Any authenticated user can create a zone (registers it as owner)
      // Must set status to 'pending-review'
      allow create: if isAuthenticated() && 
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == "pending-review";

      // Update: 
      // 1. Owners can update their details BUT NOT the status or meta fields
      // 2. Super-admins can update everything (including status)
      allow update: if isSuperAdmin() || (
        isAuthenticated() && 
        resource.data.ownerUid == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'ownerUid', 'approvedAt', 'rejectedAt', 'rejectionReason'
        ])
      );

      // Delete: Only super-admins
      allow delete: if isSuperAdmin();

      // Pricing rules used by zone admin pricing engine
      match /pricing_rules/{ruleId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isSuperAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/zones/$(zoneId)).data.ownerUid == request.auth.uid
        );
      }

      // Branches (new per-branch model)
      match /branches/{branchId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isSuperAdmin() || (
          isAuthenticated() &&
          get(/databases/$(database)/documents/zones/$(zoneId)).data.ownerUid == request.auth.uid
        );

        // Branch resources (seat-level and court-level)
        match /resources/{resourceId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isSuperAdmin() || (
            isAuthenticated() &&
            get(/databases/$(database)/documents/zones/$(zoneId)).data.ownerUid == request.auth.uid
          );
        }
      }
    }

    // Booking Offers (Zones replying to requests)
    match /booking_offers/{offerId} {
      allow read: if isAuthenticated();
      // Contract (Phase 1):
      // - requestOwnerUid: player who created booking request
      // - zoneOwnerUid: zone admin creating the offer
      // - zoneAdminId kept as legacy alias for old docs
      allow create: if isAuthenticated() &&
        request.resource.data.requestId is string &&
        request.resource.data.requestOwnerUid is string &&
        (
          request.resource.data.zoneOwnerUid == request.auth.uid ||
          request.resource.data.zoneAdminId == request.auth.uid
        );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.zoneAdminId == request.auth.uid ||
        resource.data.zoneOwnerUid == request.auth.uid ||
        resource.data.requestOwnerUid == request.auth.uid
      );
    }

    // Team-vs-Team challenge negotiation (captains only)
    match /team_match_challenges/{challengeId} {
      allow read: if isAuthenticated() && (
        resource.data.captainAUid == request.auth.uid ||
        resource.data.captainBUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.captainAUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.captainAUid == request.auth.uid ||
        resource.data.captainBUid == request.auth.uid
      );
      allow delete: if false;
    }

    // Captain-only chat created immediately after challenge acceptance
    match /team_match_chats/{chatId} {
      allow read: if isAuthenticated() &&
        resource.data.participantUids.hasAny([request.auth.uid]);
      allow create: if isAuthenticated() &&
        request.resource.data.participantUids.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() &&
        resource.data.participantUids.hasAny([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/team_match_chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          get(/databases/$(database)/documents/team_match_chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
        allow update: if false;
        allow delete: if false;
      }
    }

    // Zone Registrations (Legacy - can keep for now)
    match /zone_registrations/{regId} {
        allow read, write: if isSuperAdmin(); 
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
