rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /teams/{teamId}/{allPaths=**} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;
      
      // Allow captains to upload/delete their team logo
      // We verify the captainUid from the Firestore team document
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/teams/$(teamId)).data.captainUid == request.auth.uid;
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
