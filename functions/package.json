{
    "name": "functions",
    "scripts": {
        "build": "tsc",
        "serve": "npm run build && npx -y firebase-tools emulators:start --only functions",
        "shell": "npm run build && npx -y firebase-tools functions:shell",
        "start": "npm run shell",
        "deploy": "npx -y firebase-tools deploy --only functions",
        "logs": "npx -y firebase-tools functions:log"
    },
    "engines": {
        "node": "18"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^4.5.0",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "typescript": "^4.9.0",
        "firebase-functions-test": "^3.1.0"
    },
    "private": true
}