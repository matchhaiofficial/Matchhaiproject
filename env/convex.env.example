# Convex deployment environment variables.
# Configure these in the Convex dashboard or CLI for the target deployment.

STEAM_API_KEY=your-steam-api-key
FACEIT_API_KEY=your-faceit-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="MatchHai <no-reply@example.com>"
DIDIT_API_KEY=your-didit-api-key
DIDIT_KYC_WORKFLOW_ID=acbc8323-bcdc-4ea5-aaf8-8eacf978cb83
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_URL=https://your-convex-site.convex.site/kyc/didit/webhook
DIDIT_CALLBACK_URL=matchhai://
VEEVOTECH_API_HASH=your-veevotech-api-hash
VEEVOTECH_SENDER_ID=your-veevotech-sender-id
# Optional override; defaults to https://api.veevotech.com/v3/sendsms
# VEEVOTECH_SMS_URL=https://api.veevotech.com/v3/sendsms

# Optional Super Admin allowlist. Configure individual emails server-side only.
SUPER_ADMIN_EMAIL_JUNAID=
SUPER_ADMIN_EMAIL_EHTESHAN=
SUPER_ADMIN_EMAIL_ZEERAK=
SUPER_ADMIN_EMAIL_MUBEEN=
SUPER_ADMIN_EMAIL_SAAD=
SUPER_ADMIN_EMAIL_OVAIS=
# Alternative JSON format:
# SUPER_ADMIN_ALLOWLIST_JSON=[{"displayName":"Junaid","email":"junaid@example.com","role":"super_admin","isActive":true}]
ANTIDEO_API_KEY=your-antideo-api-key
EASYPAISA_ENV=staging
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_HASH_KEY=your-easypaisa-hash-key
EASYPAISA_API_USERNAME=your-easypaisa-rest-username
EASYPAISA_API_PASSWORD=your-easypaisa-rest-password
EASYPAISA_ACCOUNT_NUM=your-easypaisa-account-number
EASYPAISA_DEFAULT_FLOW=rest
EASYPAISA_HOSTED_FALLBACK_ENABLED=1
