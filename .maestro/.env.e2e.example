# ---------------------------------------------------------------------------
# MatchHai Maestro E2E environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env.e2e` and fill in real values for your STAGING/DEV
# environment. NEVER commit `.env.e2e` (it is gitignored) and NEVER put real
# production credentials, production Convex URLs, or real Easypaisa numbers
# in here. Staging/dev only.
#
# Run flows with these vars exported, e.g. (PowerShell):
#   Get-Content .maestro\.env.e2e | ForEach-Object { if ($_ -and -not $_.StartsWith('#')) { $k,$v = $_.Split('=',2); [Environment]::SetEnvironmentVariable($k,$v) } }
#   npm run e2e:maestro
# or pass per-run (Maestro supports -e KEY=VALUE):
#   maestro test -e E2E_USER_EMAIL=... -e E2E_USER_PASSWORD=... .maestro
# ---------------------------------------------------------------------------

# App identifier Maestro launches. This MUST match the installed build's id.
#   - Android package (from app.json): com.ovaisto.matchhai
#   - iOS bundle id  (from app.json):  com.ovaisto.matchhai
# Both platforms share the same id here, so a single value works.
E2E_APP_ID=com.ovaisto.matchhai

# Primary seeded player (host / captain in most flows). Use a STAGING account.
E2E_USER_EMAIL=player.one@example.com
E2E_USER_PASSWORD=replace-me

# Second seeded player (the one who requests to join). STAGING account.
E2E_USER2_EMAIL=player.two@example.com
E2E_USER2_PASSWORD=replace-me

# Host / captain account used by approval + result flows. May be the same as
# E2E_USER_EMAIL if your seed makes player.one the host/captain.
E2E_HOST_EMAIL=player.one@example.com
E2E_HOST_PASSWORD=replace-me

# Optional: a known matchroom title to assert against in discover/join flows.
# Leave as-is to use the default the create flow types.
E2E_MATCHROOM_TITLE=E2E Auto Match

# Optional: game label exactly as shown in the Select Game grid (e.g. "CS2",
# "Valorant", "FC26", "Tekken 8"). The seeded user must have this game added
# to their profile or it will not appear in the create grid.
E2E_GAME_LABEL=CS2
